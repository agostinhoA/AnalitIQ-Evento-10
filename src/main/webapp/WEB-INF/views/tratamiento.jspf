<div class="treatment-filter"><label for="tratamiento">Nombre del tratamiento <span class="muted">(opcional)</span></label><select id="tratamiento" name="tratamiento" aria-describedby="tratamiento-ayuda"><option value="" ${empty tratamientoValor ? 'selected' : ''}>Todos los tratamientos</option><c:forEach var="tipo" items="${tipos}"><option value="<c:out value='${tipo.nombre}'/>" ${tratamientoValor == tipo.nombre ? 'selected' : ''}><c:out value="${tipo.nombre}"/></option></c:forEach></select><p class="range-help" id="tratamiento-ayuda">Elegí un tratamiento del catálogo o consultá todos los activos con cuotas pendientes en el rango.</p></div>
